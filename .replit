modules = ["python-3.11"]
[agent]
expertMode = true

[userenv]

[userenv.shared]
LLM_BASE_URL = "https://openrouter.ai/api/v1"
LLM_API_KEY_ENV = "OPENAI_API_KEY"
LLM_MODEL = "openrouter/free"
TOP_K = "5"
MAX_TOKENS = "800"
CHUNK_SIZE = "500"
CHUNK_OVERLAP = "100"
POLICIES_DIR = "./policies"
CHROMA_PATH = "./chroma_db"
PORT = "5000"
FLASK_DEBUG = "false"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 app.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
